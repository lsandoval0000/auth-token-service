# Template only — copy to .env for local development and fill in real values.
# `mvn quarkus:dev` loads a project-root .env; packaged runs read OS environment variables.
# NEVER commit a filled-in .env (it is gitignored).

# --- Database ---
DB_USER=<db-username>
DB_PASSWORD=<db-password>
DB_URL=jdbc:postgresql://localhost:5432/<database-name>

# --- JWT keys (absolute file path or classpath: resource) ---
JWT_PRIVATE_KEY_LOCATION=./privateKey.pem
JWT_PUBLIC_KEY_LOCATION=./publicKey.pem

# --- Registered API client ---
EXCHANGE_RATE_INFORMER_SECRET=<client-secret>
